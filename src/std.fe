int abs(int x) {
    if (x < 0) { return -x; }
    return x;
}

int min(int a, int b) {
    if (a < b) { return a; }
    return b;
}

int max(int a, int b) {
    if (a > b) { return a; }
    return b;
}

int clamp(int x, int lo, int hi) {
    if (x < lo) { return lo; }
    if (x > hi) { return hi; }
    return x;
}

long pow(long base, int exp) {
    if (exp < 0) { panic("pow: negative exponent"); }
    long r = 1;
    while (exp > 0) {
        r = r * base;
        exp = exp - 1;
    }
    return r;
}

void assert(bool cond, string msg) {
    if (!cond) { panic(msg); }
}